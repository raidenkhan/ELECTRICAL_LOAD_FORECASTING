# Database Settings
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=loadforecast
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/loadforecast

# Redis Settings
REDIS_URL=redis://redis:6379/0

# API Settings
API_V1_PREFIX=/api/v1
