DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security
SECRET_KEY=generate-a-secure-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
