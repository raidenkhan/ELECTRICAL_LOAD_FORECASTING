# Environment — SQLite (default, no external DB needed)
DATABASE_URL=sqlite+aiosqlite:///./data/loadforecast.db

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Load Forecasting API
DEBUG=True
ALLOWED_ORIGINS=http://localhost:8000

# Model Paths
MODEL_DIR=./models

# Feature Engineering
LAG_FEATURES=1,4,24,96
ROLLING_WINDOWS=4,24,96

# Security (Change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
