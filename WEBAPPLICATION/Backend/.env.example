# Environment
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loadforecast
REDIS_URL=redis://localhost:6379/0

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Load Forecasting API
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Model Paths
MODEL_DIR=./models
STLF_AUTOFORMER_PATH=./models/autoformer_stlf.pt
STLF_LIGHTGBM_PATH=./models/lightgbm_stlf.pkl
LTLF_RECURSIVE_PATH=./models/ltlf_recursive.pkl

# Feature Engineering
LAG_FEATURES=1,4,24,96
ROLLING_WINDOWS=4,24,96

# Security (Change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
